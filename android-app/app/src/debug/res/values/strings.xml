<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds install alongside the released app (see applicationIdSuffix in
     build.gradle.kts), so every user-visible name has to say which one this is.
     `ime_name` is the one that matters: it labels the SERVICE, and that is what
     the system keyboard list shows. Overriding only `app_name` renamed the icon
     and left the two keyboards indistinguishable in Settings. -->
<resources>
    <string name="app_name">Medžuslovjansky (test)</string>
    <string name="ime_name">Medžuslovjansky (test)</string>
</resources>
