<?xml version="1.0" encoding="utf-8"?>
<!-- IME metadata. ONE keyboard in the system, "Interslove" (owner 2026-11-11,
     parity with iOS 0.6.3); its languages are ticked inside the keyboard and
     the app (Lang.enabled) and switched there, not by the system.

     From 3.5.9 to 3.8.16 every language was a subtype of its own here (ids
     5617-5629 and 5640-5642 - never reuse them). At sixteen languages the
     system list was long, and a language added by a later build arrived
     unticked and invisible. Those old ticks cannot be read back (Lang.migrate).

     The one subtype left keeps overridesImplicitlyEnabledSubtype: no phone is
     ever set to `isv`, so without the flag Android would enable nothing of
     ours on a fresh install (measured 2026-11-04). With one subtype there is
     no list left for Samsung's master switch to wipe - the trouble the flag
     caused while there were several. Its row shows ime_name. Its id stays
     5617 so the system keeps the keyboard switched on across the update.
     -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/ime_name"
        android:languageTag="isv"
        android:imeSubtypeLocale="isv"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lang=isv"
        android:subtypeId="5617"
        android:overridesImplicitlyEnabledSubtype="true" />
</input-method>
