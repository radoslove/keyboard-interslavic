    <subtype
        android:label="@string/subtype_ru"
        android:languageTag="ru"
        android:imeSubtypeLocale="ru"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lang=ru"
        android:subtypeId="5629" />
</input-method>
