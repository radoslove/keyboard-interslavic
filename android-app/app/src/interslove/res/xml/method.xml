<?xml version="1.0" encoding="utf-8"?>
<!-- IME metadata. One subtype per language, so each shows in the system
     keyboard list and picker the way iOS lists one keyboard per language.
     The app's own language is on by default (overridesImplicitlyEnabledSubtype);
     the others are ticked on the system's Languages page (the app's button
     opens it). Only that one carries the flag, because Android shows NO name
     for a subtype that has it. subtypeId keeps each identity fixed: without it
     the system hashes label + extra value, and any change drops what the user
     ticked. Ids are per app and never reused.
     ⚠ The flag was removed on 2026-11-04 and put back the same evening, so do
     not remove it again without reading this. Samsung draws the subtype that
     carries it as a MASTER switch above the others, and turning that switch on
     WIPES the explicitly enabled list - the keyboard is left with one language,
     the globe stops cycling and opens the system picker, and the phone ends up
     on another keyboard. That is real and it happened on the Android test phone. It is still the
     smaller evil. Measured on a fresh install with nothing ticked: Android
     implicitly enables the subtypes that match the PHONE's locales - on a phone
     set to en-US with pl-PL and nb-NO it switched on English, Polish and the
     nb-tagged subtype, and left Czech off because the phone has no Czech locale.
     No phone is ever set to `isv`, so without this flag the app's own language
     is the one language a new user does NOT get. The nameless row the flag
     causes is not a defect in a RELEASE build: the row shows ime_name, which
     reads Medzuslovjansky there, and only carries a number in test builds.
     A language added by a LATER build is NOT switched on by itself on a phone
     that already has the app: the new subtype arrives unticked, so it is
     invisible in the keyboard picker until the user ticks it (or, over USB,
     adb shell settings put secure enabled_input_methods "<old>;<new id>").
     Cost a round trip 2026-11-01: Czech shipped in 3.5.31 and the owner could
     not find it on the Android test phone.
     -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/subtype_isv"
        android:languageTag="isv"
        android:imeSubtypeLocale="isv"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lang=isv"
        android:subtypeId="5617"
        android:overridesImplicitlyEnabledSubtype="true" />
    <subtype
        android:label="@string/subtype_isc"
        android:languageTag="nb"
